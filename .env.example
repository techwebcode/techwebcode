# TechWebCode Environment Configuration Template

# Database Credentials (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=techwebcode
DB_USER=techwebcode_user
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_SECURE_ROOT_PASSWORD
MYSQL_HOST_PORT=3600

# Service Ports & Environment
APP_ENV=production
PORT=8080
BACKEND_PORT=8082
FRONTEND_PORT=3000
ADMIN_PORT=3001

# Authentication & Secrets (Server-only secret)
ADMIN_SECRET=YOUR_SECURE_ADMIN_SECRET

# API URLs
# Public API URL accessible from client browsers
NEXT_PUBLIC_API_URL=http://localhost:8082/api/v1
# Internal API URL for container-to-container SSR calls inside Docker network
INTERNAL_API_URL=http://backend:8080/api/v1

# Media Storage Configuration
# Host directory path on server for media storage
MEDIA_HOST_PATH=/var/www/techwebcode-media
# Container mount target directory path
UPLOAD_PATH=/var/www/techwebcode-media
MAX_UPLOAD_SIZE=5242880
