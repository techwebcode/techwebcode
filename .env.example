# ==============================================================================
# TechWebCode Environment Configuration Template
# ==============================================================================
# Copy this template to `.env` in production and replace placeholder values.
# To generate strong random secrets for production, run:
#   openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Never expose to browser or git repository)
# ------------------------------------------------------------------------------
# MySQL Root Password
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# MySQL Application Database Credentials
MYSQL_DATABASE=techwebcode
MYSQL_USER=techwebcode
MYSQL_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Backend Admin Authentication Secret Key
ADMIN_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Database Direct Mappings (Reuses MySQL variables for backend application)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=techwebcode
DB_USER=techwebcode
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ------------------------------------------------------------------------------
# 2. DOCKER INTERNAL & APPLICATION ROUTING (Server-only / Container internal)
# ------------------------------------------------------------------------------
APP_ENV=production
PORT=8080
BACKEND_PORT=8082
FRONTEND_PORT=3000
ADMIN_PORT=3001
MYSQL_HOST_PORT=3600

# Docker Container-to-Container Internal API URL (Used by Next.js SSR / Server-side rendering)
INTERNAL_API_URL=http://backend:8080/api/v1

# ------------------------------------------------------------------------------
# 3. PUBLIC / CLIENT-SIDE VARIABLES (Safe for browser exposure)
# ------------------------------------------------------------------------------
# Public API URL (Used by client-side browser requests)
NEXT_PUBLIC_API_URL=http://localhost:8082/api/v1

# Frontend Origin URL
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. MEDIA & FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
MEDIA_HOST_PATH=/var/www/techwebcode-media
UPLOAD_PATH=/var/www/techwebcode-media
MAX_UPLOAD_SIZE=5242880

# ------------------------------------------------------------------------------
# 5. CONTACT & EMAIL SUPPORT SYSTEM (SMTP Server Credentials)
# ------------------------------------------------------------------------------
SUPPORT_EMAIL=support@techwebcode.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@techwebcode.in
SMTP_PASS=your-smtp-password
